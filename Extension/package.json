{
  "name": "@answersense/extension",
  "version": "0.1.6",
  "description": "AnswerSense: Forms - Chromium extension",
  "type": "module",
  "scripts": {
    "build": "vite build --mode extension && vite build --mode content",
    "dev": "node scripts/dev.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "license": "LicenseRef-AnswerSense-Source-Available-1.0",
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.1",
    "happy-dom": "^20.14.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
