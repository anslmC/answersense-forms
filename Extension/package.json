{
  "name": "@answersense/extension",
  "version": "0.1.0",
  "description": "AnswerSense: Forms - Chromium extension",
  "main": "dist/index.js",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "vite build --mode extension && vite build --mode content",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ tests/ --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [],
  "author": "",
  "license": "PolyForm-Shield-1.0.0",
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.1",
    "happy-dom": "^20.14.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
