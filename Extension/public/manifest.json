{
  "manifest_version": 3,
  "name": "AnswerSense: Forms",
  "version": "0.1.0",
  "description": "AI-assisted Chromium browser extension for supported Google Forms.",
  "permissions": [],
  "host_permissions": ["https://docs.google.com/forms/*"],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/Popup/Popup.html",
    "default_title": "AnswerSense: Forms"
  },
  "icons": {}
}
